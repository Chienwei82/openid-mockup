<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>OidcMock.Host</RootNamespace>
    <UserSecretsId>oidc-mock-host</UserSecretsId>
  </PropertyGroup>

  <!--
    Publicacion autocontenida y de un solo archivo: el mock se copia a un equipo o a un contenedor
    sin instalar el runtime de .NET. El RID se lo pasa publish.sh o el Dockerfile (linux-x64 y
    win-x64); sin RID, la salida es framework-dependent, que es lo que se quiere para 'dotnet run'.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OidcMock.Core\OidcMock.Core.csproj" />
  </ItemGroup>

  <!--
    La configuracion se publica como archivos reales junto al ejecutable, no empaquetada dentro del
    binario: tiene que poder verse y editarse sin desempaquetar nada (ExcludeFromSingleFile), y el
    binario no autoextrae contenido (sin IncludeAllContentForSelfExtract) para que
    AppContext.BaseDirectory siga siendo la carpeta del ejecutable y el config/ de al lado se
    encuentre. PublishLayoutTests fija este contrato.
  -->
  <ItemGroup>
    <Content Include="..\..\config\*.json" Link="config\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OidcMock.IntegrationTests" />
  </ItemGroup>

</Project>
