{
  "name": "hyperframes-explain",
  "version": "1.0.0",
  "private": true,
  "description": "Explicador OIDC en video (HyperFrames) para OidcMock",
  "type": "module",
  "scripts": {
    "audio": "node scripts/generate_audio.mjs",
    "build": "python3 scripts/build_composition.py",
    "check": "hyperframes check .",
    "render": "hyperframes render . --quality standard -o dist/oidc-explainer.mp4",
    "preview": "hyperframes preview ."
  },
  "devDependencies": {
    "hyperframes": "^0.8.140",
    "yauzl": "^3.4.0"
  },
  "dependencies": {
    "@lobehub/tts": "^5.2.1",
    "ws": "^8.22.0"
  }
}
