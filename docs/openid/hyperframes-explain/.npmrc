# El audio solo importa la entrada de Node de @lobehub/tts, pero esa librería
# declara peers de navegador (react, react-dom, antd, @lobehub/ui). Sin esta
# línea npm (>= 7) los autoinstala —unos 400 paquetes— y avisa del conflicto
# react@19 que pide @lobehub/ui contra @emoji-mart/react (react <= 18).
# Con legacy-peer-deps el árbol baja de ~560 a ~230 paquetes, no hay avisos y el
# TTS sigue funcionando (verificado: EdgeSpeechTTS sigue sintetizando MP3).
legacy-peer-deps=true
